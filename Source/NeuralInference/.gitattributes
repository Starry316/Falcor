# Preserve imported bytes across machines so UPSTREAM.json hashes stay valid.
*.cpp -text
*.cu -text
*.h -text
# Imported sources retain CRLF; do not report their carriage returns as spaces.
*.cpp whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.cu whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.h whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
